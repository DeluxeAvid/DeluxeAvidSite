---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    left: ImageMetadata;
    right: ImageMetadata;
    leftAlt: string;
    rightAlt: string;
    leftCaption?: string;
    rightCaption?: string;
    layout?: 'normal' | 'wide';
}

const {
    left,
    right,
    leftAlt,
    rightAlt,
    leftCaption,
    rightCaption,
    layout = 'normal',
} = Astro.props;
---

<div class:list={['image-compare', layout]}>
    <figure>
        <Image src={left} alt={leftAlt} />
        {leftCaption && <figcaption>{leftCaption}</figcaption>}
    </figure>

    <figure>
        <Image src={right} alt={rightAlt} />
        {rightCaption && <figcaption>{rightCaption}</figcaption>}
    </figure>
</div>

<style>
    .image-compare {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin: 2em 0;
    }

    .image-compare.wide {
        width: 960px;
        max-width: calc(100vw - 2em);
        margin-left: 50%;
        transform: translateX(-50%);
}

    figure {
        min-width: 0;
        margin: 0;
    }

    img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 8px;
    }

    figcaption {
        margin-top: 0.5em;
        color: rgb(var(--gray));
        font-size: 0.85em;
        text-align: center;
    }

    @media (max-width: 720px) {
        .image-compare {
            grid-template-columns: 1fr;
        }
    }
</style>