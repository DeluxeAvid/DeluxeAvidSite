---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
    src: ImageMetadata;
    alt: string;
    caption?: string;
}

interface Props {
    images: GalleryItem[];
    columns?: 2 | 3 | 4;
    layout?: 'normal' | 'wide';
}

const {
    images,
    columns = 3,
    layout = 'normal',
} = Astro.props;
---

<div
    class:list={['image-gallery', layout]}
    style={`--gallery-columns: ${columns}`}
>
    {images.map((item) => (
        <figure>
            <Image src={item.src} alt={item.alt} />
            {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
    ))}
</div>

<style>
    .image-gallery {
        display: grid;
        grid-template-columns: repeat(var(--gallery-columns), minmax(0, 1fr));
        gap: 1rem;
        margin: 2em 0;
    }

    .image-gallery.wide {
        width: 960px;
        max-width: calc(100vw - 2em);
        margin-left: 50%;
        transform: translateX(-50%);
    }

    figure {
        min-width: 0;
        margin: 0;
    }

    img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 8px;
    }

    figcaption {
        margin-top: 0.5em;
        color: rgb(var(--gray));
        font-size: 0.85em;
        text-align: center;
    }

    @media (max-width: 720px) {
        .image-gallery {
            grid-template-columns: repeat(
                min(var(--gallery-columns), 2),
                minmax(0, 1fr)
            );
        }

        .image-gallery.wide {
            max-width: calc(100vw - 2em);
        }
    }
</style>