---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    src: ImageMetadata;
    alt: string;
    caption?: string;
    layout?: 'normal' | 'wide';
}

const { 
    src,
    alt, 
    caption, 
    layout = 'normal',
} = Astro.props;
---

<figure class={layout}>
    <Image src={src} alt={alt} />
    {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
    figure {
        margin: 2em 0;
    }

    figure.wide {
        width: 960px;
        max-width: calc(100vw - 2em);
        margin-left: 50%;
        transform: translateX(-50%);
}
    img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 8px;
    }

    figcaption {
        margin-top: 0.5em;
        color: rgb(var(--gray));
        font-size: 0.85em;
        text-align: center;
    }
</style>