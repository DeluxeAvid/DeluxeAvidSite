
<div class="music-player" transition:persist="music-player">
  <button
    class="toggle-button"
    id="music-player-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="music-player-panel"
  >
    <span aria-hidden="true">♫</span>
    <span>音樂播放器</span>
    <span class="arrow" aria-hidden="true">⌃</span>
  </button>

  <section
    class="player-panel"
    id="music-player-panel"
    hidden
    aria-label="音樂播放器"
  >
    <div class="panel-header">
      <strong>Music Player</strong>
      <span class="status">尚未設定音源</span>
    </div>

    <div class="player-content">
      <div class="track-info">
        <span class="track-title">With an Orchid</span>
        <span class="track-artist">Yanni</span>
      </div>

      <audio
        id="local-audio"
        controls
        preload="metadata"
      >
        <source
          src={`${import.meta.env.BASE_URL}music/Yanni%20-%20With%20an%20Orchid.mp3`}
          type="audio/mpeg"
        />
        你的瀏覽器不支援音訊播放。
      </audio>
    </div>
  </section>
</div>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) {
      return;
    }

    const toggle = target.closest<HTMLButtonElement>(
      "#music-player-toggle",
    );

    if (!toggle) {
      return;
    }

    const panel = document.querySelector<HTMLElement>(
      "#music-player-panel",
    );

    if (!panel) {
      return;
    }

    const isExpanded = toggle.getAttribute("aria-expanded") === "true";

    toggle.setAttribute("aria-expanded", String(!isExpanded));
    panel.hidden = isExpanded;
  });
</script>

<style>
  .music-player {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 1000;
    width: min(320px, calc(100vw - 32px));
    color: var(--text-primary);
  }

  .toggle-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--text-secondary);
    border-radius: 12px;
    background: var(--surface-bg);
    color: var(--text-primary);
    font: inherit;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .toggle-button > span:first-child {
    font-size: 1.3rem;
  }

  .arrow {
    transition: transform 0.2s ease;
  }

  .toggle-button[aria-expanded="true"] .arrow {
    transform: rotate(180deg);
  }

  .player-panel {
    margin-bottom: 10px;
    padding: 16px;
    border: 1px solid var(--text-secondary);
    border-radius: 12px;
    background: var(--surface-bg);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .player-panel[hidden] {
    display: none;
  }

  .panel-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .status,
  .player-placeholder small {
    color: var(--text-secondary);
    font-size: 0.8rem;
  }

    .player-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 20px;
  }

  .track-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .track-title {
    font-weight: 600;
  }

  .track-artist {
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .player-content audio {
    display: block;
    width: 100%;
    height: 40px;
  }

  @media (max-width: 600px) {
    .music-player {
      right: 16px;
      bottom: 16px;
    }
  }
</style>
